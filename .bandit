[bandit]
# Keep the scan focused on project sources. The virtualenv contains
# third-party packages and generated bytecode that should not be audited.
# Globs are used because Bandit expands real directory paths before matching.
# This file is the only Bandit configuration: pyproject.toml cannot express
# these globs, so a [tool.bandit] table there would not exclude anything.
exclude = */.venv/*,*/__pycache__/*,*/.git/*,*/tests/*
